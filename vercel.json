{
  "version": 2,
  "buildCommand": "npm install --prefix frontend && npm install --prefix admin_dashboard && npm run build --prefix frontend && npm run build --prefix admin_dashboard && node -e \"const fs=require('fs');fs.rmSync('frontend/dist/admin',{recursive:true,force:true});fs.cpSync('admin_dashboard/dist','frontend/dist/admin',{recursive:true});\"",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "frontend/dist/admin/assets/$1"
    },
    {
      "src": "/admin/(.*\\.js)",
      "dest": "frontend/dist/admin/$1"
    },
    {
      "src": "/admin/(.*\\.css)",
      "dest": "frontend/dist/admin/$1"
    },
    {
      "src": "/admin/(.*\\.svg)",
      "dest": "frontend/dist/admin/$1"
    },
    {
      "src": "/admin",
      "dest": "frontend/dist/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "frontend/dist/admin/index.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/(.*\\.svg)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}
